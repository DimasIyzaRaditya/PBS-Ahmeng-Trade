# Transaksi service environment

# PostgreSQL connection string for transaksi database.
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/db_transaksi"

# Internal service URL used to validate produkId before creating/updating transaksi.
PRODUK_SERVICE_URL="http://localhost:3002"

# JWT signing secret. Use the same value across gateway, user, and transaksi services.
JWT_SECRET="change_me"
