# Gateway service environment

# Database URLs used by gateway Prisma services.
# Replace username, password, host, port, and database name as needed.
USER_DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/db_user"
PRODUK_DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/db_produk"
TRANSAKSI_DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/db_transaksi"

# Internal service URL for product validation.
PRODUK_SERVICE_URL="http://localhost:3002"

# JWT signing secret. Use the same value across gateway, user, and transaksi services.
JWT_SECRET="change_me"
